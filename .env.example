# Attendance Integrity System - Backend Environment Configuration Example
# Copy to .env for local runtime customization. Never commit real secrets or production credentials.

# Server Binding
HOST=127.0.0.1
PORT=8000

# Environment Mode (production | development)
ENVIRONMENT=production

# Database Configuration
DATABASE_PATH=data/dashboard.db

# CORS Configuration (wildcard '*' or comma-separated list of allowed origins, e.g., http://localhost:3000,http://127.0.0.1:8000)
CORS_ORIGINS=*

# Static Assets Path (defaults to frontend/dist if present, else static)
FRONTEND_DIST_DIR=frontend/dist
